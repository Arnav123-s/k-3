    ]
   },
   {
    "input": {
     "m1": 2,
     "m2": 3,
     "u1": 1,
     "u2": 0
    },
    "expected": [
     1,
     1
    ]
   }
  ]
 },
 {
  "id": "physics-impulse",
  "chain": "physics",
  "request": "Write run(p). Same inputs as a 1-D perfectly elastic collision. Return the momentum gained by body 2, m2*(v2-u2), as an exact reduced fraction [num,den] with positive denominator.",
  "checks": [
   {
    "input": {
     "m1": 1,
     "m2": 1,
     "u1": -1,
     "u2": 1
    },
    "expected": [
     -2,
     1
    ]
   },
   {
    "input": {
     "m1": 1,
     "m2": 3,
     "u1": 4,
     "u2": 0
    },
    "expected": [
     6,
     1
    ]
   },
   {
    "input": {
     "m1": 2,
     "m2": 3,
